NODE_ENV="dev"
### Database Vars to format DB_URL: `mongodb://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}` 
DB_HOST="localhost"
DB_PORT=27017
DB_NAME="adeeb_db"
DB_USER="mongodb"
DB_PASSWORD="mongodb"
### Cache
VALKEY_HOST="localhost"
VALKEY_PASSWORD="password"
VALKEY_PORT=6379
### JWT
ACCESS_JWT_PRIVATE_PATH="access_jwt_private_rsa256.key"
ACCESS_JWT_PUBLIC_PATH="access_jwt_public_rsa256.key"
REFRESH_JWT_PRIVATE_PATH="refresh_jwt_private_rsa256.key"
REFRESH_JWT_PUBLIC_PATH="refresh_jwt_public_rsa256.key"
