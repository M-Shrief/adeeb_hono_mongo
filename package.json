{
  "name": "adeeb_hono",
  "version": "0.1.0",
  "description": "Adeeb's Backend iteration in JS & TS, using Hono with MongoDB",
  "type": "module",
  "keywords": [
    "JavaScript",
    "TypeScript",
    "MongoDB",
    "ValKey",
    "Hono"
  ],
  "author": "M-Shrief",
  "license": "MIT",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "test": "vitest",
