    "@scalar/hono-api-reference": "^0.11.4",
    "@valibot/to-json-schema": "^1.7.1",
    "@valkey/valkey-glide": "^2.4.2",
    "bcrypt": "^6.0.0",
    "hono": "^4.12.26",
    "hono-openapi": "^1.3.0",
    "hono-rate-limiter": "^0.5.3",
    "mongoose": "^9.9.3",
    "pino": "^10.3.1",
    "valibot": "^1.4.1"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^25.9.4",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.22.4",
    "typedoc": "^0.28.19",
    "typescript": "^6.0.3",
    "unplugin-swc": "^1.5.10",
    "vitest": "^4.1.10"
